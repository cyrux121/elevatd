# ─── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then grab from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — used ONLY in server code (seed script, webhook, admin actions)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (test mode) ────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# After running `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Resend (transactional email) ──────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@elevatedcustoms.com

# ─── Admin ─────────────────────────────────────────────────────────────
# Only this email can access /admin (must match the Supabase auth user)
ADMIN_EMAIL=jacobholicki@gmail.com
